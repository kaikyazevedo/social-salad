---
import '../styles/global.css';
---
<html lang="pt-BR">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Social Salad: meu espaço pessoal para organizar marcas, projetos e ideias."/><title>Social Salad — meu espaço de trabalho</title></head>
<body class="dots">
<header class="head"><a class="logo" href="/" aria-label="Social Salad">✳ social<span>salad</span><b>.</b></a><a class="pill" href="/app">abrir painel ↗</a></header>
<main>
<section class="hero">
  <div class="hero-text"><span class="small">ARQUIVOS SALADA / 001 &nbsp;•&nbsp; UM ESPAÇO MEU</span>
  <h1>social media,<em>mas não<br/>só post.</em></h1>
  <p>Ideias, marcas, campanhas, conteúdos e tudo que precisa sair da minha cabeça e ganhar um lugar para acontecer.</p>
  <div class="hero-actions"><a class="action" href="/demo">explorar meu espaço <span>↗</span></a><a class="ghost" href="#sistema">como funciona ↓</a></div></div>
  <div class="art" aria-label="Arte gráfica Social Salad"><div class="art-flag">ARQUIVOS<br/>SALADA</div><div class="art-star">✳</div><div class="art-tag">IDEIAS / DIREÇÃO / EXECUÇÃO</div><div class="art-index">N° 001 / SOCIAL SALAD</div></div>
</section>
<section class="intro" id="sistema"><span class="small">01 / O SISTEMA</span><h2>menos coisa<br/><em>espalhada.</em><br/>mais visão.</h2><p>Uma central pessoal para acompanhar o que estou criando, o que está em andamento e o que vem depois — sem abrir dez lugares diferentes.</p></section>
<section class="modules"><div class="section-head"><span class="small">02 / ÁREAS DE TRABALHO</span><span class="small">UM LUGAR PRA TUDO ↙</span></div><div class="module-grid">
<a href="/app#planejamento"><span>01 / CONTEÚDO</span><strong>planejamento<br/>de conteúdo</strong><small>pautas, roteiros, datas e status</small><b>↗</b></a>
<a href="/app#colecoes"><span>02 / CAMPANHAS</span><strong>coleções &<br/>lançamentos</strong><small>conceito, fases e materiais</small><b>↗</b></a>
<a href="/app#identidade"><span>03 / MARCAS</span><strong>identidade<br/>visual</strong><small>paletas, fontes e referências</small><b>↗</b></a>
<a href="/app#projetos"><span>04 / GESTÃO</span><strong>projetos<br/>& tarefas</strong><small>o que está rolando e o que falta</small><b>↗</b></a>
</div></section>
<footer><div class="logo">✳ social<span>salad</span><b>.</b></div><small>UM ESPAÇO PESSOAL EM CONSTRUÇÃO / 2026</small></footer>
</main>
</body>
</html>
<style>
.head{height:70px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 max(20px,4vw)}.head .pill{font-size:10px;letter-spacing:.05em}.hero{max-width:1500px;min-height:680px;margin:auto;padding:86px 4vw 105px;display:grid;grid-template-columns:1.2fr .8fr;align-items:center;gap:5vw}.hero-text{position:relative;z-index:2}.hero h1{font-size:clamp(65px,7.5vw,138px);font-weight:900;line-height:.87;letter-spacing:-.08em;margin:35px 0}.hero h1 em{display:block;color:var(--pink);letter-spacing:-.06em}.hero-text>p{max-width:500px;color:#e0dae0;font-size:clamp(16px,1.55vw,23px);line-height:1.4}.hero-actions{display:flex;flex-wrap:wrap;gap:24px;align-items:center;margin-top:40px}.art{aspect-ratio:4/4.5;background:radial-gradient(circle at 60% 40%,#6a215f 0%,#281529 42%,#17121b 75%);position:relative;border:1px solid #49424a;overflow:hidden;max-width:500px;min-width:0}.art:before{position:absolute;content:'';inset:0;background-image:radial-gradient(#ffffff17 .8px,transparent .8px);background-size:7px 7px}.art-flag{position:absolute;z-index:2;top:20px;left:22px;color:#0a0a0a;background:var(--acid);font-size:11px;font-weight:900;padding:7px 13px;transform:rotate(-5deg)}.art-star{position:absolute;font-size:clamp(280px,32vw,600px);color:var(--pink);line-height:1;top:10%;left:10%;transform:rotate(-17deg);filter:drop-shadow(10px 14px 0 #1f2377)}.art-tag{position:absolute;z-index:2;top:47%;right:-16px;background:#080808dd;padding:11px;font-size:10px;font-weight:800;transform:rotate(6deg)}.art-index{position:absolute;bottom:20px;left:22px;font-size:10px;letter-spacing:.14em}.intro{border-top:1px solid var(--border);padding:95px 5vw;display:grid;grid-template-columns:.5fr 1.3fr 1fr;gap:35px;align-items:start}.intro h2{font-size:clamp(47px,6.5vw,106px);letter-spacing:-.08em;line-height:.9;font-weight:900}.intro em{color:var(--acid)}.intro>p{max-width:340px;color:#b9b2be;font-size:15px;line-height:1.6}.modules{padding:25px 5vw 120px}.section-head{display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid var(--border);padding-bottom:16px}.module-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:22px}.module-grid>a{border:1px solid #55515a;min-height:270px;padding:20px;position:relative;display:flex;flex-direction:column;transition:background .15s}.module-grid>a:hover{background:#302033}.module-grid>a:nth-child(2){background:#ed2dc0;color:#130d13}.module-grid>a:nth-child(3){background:#eafa29;color:#151515}.module-grid>a>span{font-size:10px;font-weight:800;letter-spacing:.12em}.module-grid strong{font-size:clamp(22px,2.3vw,38px);line-height:1;letter-spacing:-.06em;margin-top:32px}.module-grid small{font-size:12px;margin-top:auto;opacity:.7}.module-grid b{position:absolute;right:18px;top:16px}footer{padding:28px 5vw;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:18px}footer small{font-size:10px;color:var(--muted);letter-spacing:.08em}
@media(max-width:850px){.hero{grid-template-columns:1fr;min-height:0;padding:55px 20px 70px;gap:45px}.hero h1{font-size:clamp(51px,12vw,83px);margin:25px 0 30px}.hero-text>p{font-size:16px}.art{aspect-ratio:1.1;max-width:450px;width:100%;justify-self:center}.art-star{font-size:390px}.intro{padding:70px 20px;grid-template-columns:1fr;gap:25px}.intro h2{font-size:clamp(53px,12vw,85px)}.modules{padding:0 20px 65px}.module-grid{grid-template-columns:repeat(2,1fr)}.module-grid>a{min-height:230px}.module-grid strong{font-size:26px}footer{padding:25px 20px;flex-wrap:wrap}}@media(max-width:470px){.head .logo{font-size:19px}.head .pill{padding:10px}.hero h1{font-size:clamp(48px,12vw,63px)}.art{aspect-ratio:1.1}.art-star{font-size:340px}.module-grid{grid-template-columns:1fr}.module-grid>a{min-height:175px}.module-grid strong{margin-top:20px;font-size:30px}.section-head .small:last-child{display:none}}
</style>
